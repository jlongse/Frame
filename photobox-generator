========================================================= */

function addOrUpdateItem() {

    const data =
        getFormData();


    if (
        data.type === "polaroid" &&
        !data.image
    ) {
        setStatus(
            "formStatus",
            "Añade una URL para la Polaroid.",
            true
        );
        return;
    }


    if (
        data.type === "sticky-png" &&
        !data.image
    ) {
        setStatus(
            "formStatus",
            "Añade una URL para el Sticky PNG.",
            true
        );
        return;
    }


    if (
        data.type === "ticket" &&
        !data.image
    ) {
        setStatus(
            "formStatus",
            "Añade una URL para el Ticket.",
            true
        );
        return;
    }


    if (
        data.type === "png-frame" &&
        !data.image
    ) {
        setStatus(
            "formStatus",
            "Añade una URL para el PNG Frame.",
            true
        );
        return;
    }


    if (
        data.type === "film-strip" &&
        !data.images.some(
            image => image.image
        )
    ) {
        setStatus(
            "formStatus",
            "Añade al menos una imagen al Film Strip.",
            true
        );
        return;
    }


    if (editingIndex >= 0) {

        items[editingIndex] =
            data;

        setStatus(
            "formStatus",
            "Elemento actualizado."
        );

    } else {

        items.push(data);

        setStatus(
            "formStatus",
            "Elemento añadido."
        );
    }


    saveItems();

    renderItems();

    generateHtml();


    clearForm();
}


