========================================================= */

function getTypeLabel(type) {

    const labels = {
        "polaroid": "Polaroid",
        "sticky": "Sticky Note",
        "sticky-fecha": "Sticky Note + Fecha",
        "sticky-png": "Sticky PNG",
        "ticket": "Ticket",
        "png-frame": "PNG Frame",
        "diary": "Diary Notes",
        "film-strip": "Film Strip"
    };

    return labels[type] ||
        type;
}


function getItemDescription(item) {

    if (item.type === "polaroid") {

        return (
            item.caption ||
            item.alt ||
            item.image ||
            "(sin contenido)"
        );
    }


    if (item.type === "sticky") {

        return (
            item.text ||
            "(sin texto)"
        );
    }


    if (item.type === "sticky-fecha") {

        return (
            item.fecha ||
            item.text ||
            "(sin contenido)"
        );
    }


    if (item.type === "sticky-png") {

        return (
            item.alt ||
            "(sin ALT)"
        );
    }


    if (item.type === "ticket") {

        return (
            item.alt ||
            item.image ||
            "(sin contenido)"
        );
    }


    if (item.type === "png-frame") {

        return (
            item.alt ||
            item.image ||
            "(sin contenido)"
        );
    }


    if (item.type === "diary") {

        return (
            item.text
                ?.replace(/\n+/g, " ")
                .slice(0, 100) ||
            "(sin contenido)"
        );
    }


    if (item.type === "film-strip") {

        return (
            item.name ||
            "Sin nombre"
        );
    }


    return "";
}


/* =========================================================
   RENDERIZAR LISTA
========================================================= */

function renderItems() {

    const list =
        $("itemList");

    list.innerHTML = "";


    if (!items.length) {

        const empty =
            document.createElement("div");

        empty.className =
            "empty";

        empty.textContent =
            "No hay elementos todavía.";

        list.appendChild(empty);

        return;
    }


    items.forEach(
        (item, index) => {

            const row =
                document.createElement("div");

            row.className =
                "item";

            /*
                Guardamos la referencia directa al objeto.
                Esto evita problemas de índices cuando
                se reordena mediante drag & drop.
            */
            row._item = item;


            const number =
                document.createElement("div");

            number.className =
                "item-number";

            number.textContent =
                index + 1;


            const info =
                document.createElement("div");

            info.className =
                "item-info";


            const type =
                document.createElement("div");

            type.className =
                "item-type";

            type.textContent =
                getTypeLabel(item.type);


            const description =
                document.createElement("div");

            description.className =
                "item-description";

            description.textContent =
                getItemDescription(item);


            info.appendChild(type);
            info.appendChild(description);


            const actions =
                document.createElement("div");

            actions.className =
                "item-actions";


            const up =
                document.createElement("button");

            up.type = "button";
            up.textContent = "↑";
            up.title = "Subir";

            up.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    if (
                        Date.now() <
                        suppressClickUntil
                    ) {
                        return;
                    }

                    const currentIndex =
                        items.indexOf(row._item);

                    if (currentIndex > 0) {

                        [
                            items[currentIndex - 1],
                            items[currentIndex]
                        ] = [
                            items[currentIndex],
                            items[currentIndex - 1]
                        ];

                        saveItems();
                        renderItems();
                        generateHtml();
                    }
                }
            );


            const down =
                document.createElement("button");

            down.type = "button";
            down.textContent = "↓";
            down.title = "Bajar";

            down.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    if (
                        Date.now() <
                        suppressClickUntil
                    ) {
                        return;
                    }

                    const currentIndex =
                        items.indexOf(row._item);

                    if (
                        currentIndex >= 0 &&
                        currentIndex < items.length - 1
                    ) {

                        [
                            items[currentIndex + 1],
                            items[currentIndex]
                        ] = [
                            items[currentIndex],
                            items[currentIndex + 1]
                        ];

                        saveItems();
                        renderItems();
                        generateHtml();
                    }
                }
            );


            const edit =
                document.createElement("button");

            edit.type = "button";
            edit.textContent = "Editar";

            edit.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    if (
                        Date.now() <
                        suppressClickUntil
                    ) {
                        return;
                    }

                    const currentIndex =
                        items.indexOf(row._item);

                    if (currentIndex >= 0) {
                        editItem(currentIndex);
                    }
                }
            );


            const duplicate =
                document.createElement("button");

            duplicate.type = "button";
            duplicate.textContent = "Duplicar";

            duplicate.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    if (
                        Date.now() <
                        suppressClickUntil
                    ) {
                        return;
                    }

                    const currentIndex =
                        items.indexOf(row._item);

                    if (currentIndex >= 0) {

                        const copy =
                            JSON.parse(
                                JSON.stringify(
                                    items[currentIndex]
                                )
                            );

                        items.splice(
                            currentIndex + 1,
                            0,
                            copy
                        );

                        saveItems();
                        renderItems();
                        generateHtml();
                    }
                }
            );


            const del =
                document.createElement("button");

            del.type = "button";
            del.textContent = "Eliminar";

            del.addEventListener(
                "click",
                event => {

                    event.stopPropagation();

                    if (
                        Date.now() <
                        suppressClickUntil
                    ) {
                        return;
                    }

                    const currentIndex =
                        items.indexOf(row._item);

                    if (currentIndex >= 0) {

                        items.splice(
                            currentIndex,
                            1
                        );

                        saveItems();
                        renderItems();
                        generateHtml();
                    }
                }
            );


            actions.appendChild(up);
            actions.appendChild(down);
            actions.appendChild(edit);
            actions.appendChild(duplicate);
            actions.appendChild(del);


            row.appendChild(number);
            row.appendChild(info);
            row.appendChild(actions);


            list.appendChild(row);


            attachDragHandlers(row);
        }
    );
}


/* =========================================================
   DRAG & DROP
========================================================= */

function getItemRows() {

    return [
        ...$("itemList").children
    ].filter(
        element =>
            element.classList.contains("item")
    );
}


function createPlaceholder(row) {

    const rect =
        row.getBoundingClientRect();

    const placeholder =
        document.createElement("div");

    placeholder.className =
        "drag-placeholder";

    placeholder.style.width =
        rect.width + "px";

    placeholder.style.height =
        rect.height + "px";

    placeholder.style.marginBottom =
        getComputedStyle(row).marginBottom;


    return placeholder;
}


function movePlaceholder(beforeElement) {

    if (!dragState) {
        return;
    }

    const list =
        $("itemList");

    const placeholder =
        dragState.placeholder;


    if (!placeholder) {
        return;
    }


    if (beforeElement) {

        if (
            placeholder.nextElementSibling ===
            beforeElement
        ) {
            return;
        }

    } else {

        if (
            list.lastElementChild ===
            placeholder
        ) {
            return;
        }
    }


    const movingElements =
        [
            ...list.children
        ].filter(
            element =>
                element.classList.contains("item") ||
                element === placeholder
        );


    const firstRects =
        new Map(
            movingElements.map(
                element => [
                    element,
                    element.getBoundingClientRect()
                ]
            )
        );


    if (beforeElement) {

        list.insertBefore(
            placeholder,
            beforeElement
        );

    } else {

        list.appendChild(
            placeholder
        );
    }


    requestAnimationFrame(() => {

        [
            ...list.children
        ].forEach(element => {

            if (
                element.classList.contains(
                    "dragging"
                )
            ) {
                return;
            }


            const old =
                firstRects.get(element);

            if (!old) {
                return;
            }


            const now =
                element.getBoundingClientRect();


            const dx =
                old.left - now.left;

            const dy =
                old.top - now.top;


            if (
                Math.abs(dx) > .5 ||
                Math.abs(dy) > .5
            ) {

                element.animate(
                    [
                        {
                            transform:
                                `translate(${dx}px, ${dy}px)`
                        },
                        {
                            transform:
                                "translate(0,0)"
                        }
                    ],
                    {
                        duration: 180,
                        easing:
                            "cubic-bezier(.2,.8,.2,1)"
                    }
                );
            }
        });
    });
}


function updatePlaceholder(clientY) {

    if (!dragState) {
        return;
    }


    const list =
        $("itemList");


    const candidates =
        [
            ...list.children
        ].filter(
            element =>
                element.classList.contains("item") &&
                !element.classList.contains("dragging")
        );


    let before = null;


    for (const element of candidates) {

        const rect =
            element.getBoundingClientRect();


        if (
            clientY <
            rect.top + rect.height / 2
        ) {

            before = element;

            break;
        }
    }


    movePlaceholder(before);
}


function clearDragInlineStyles(row) {

    if (!row) {
        return;
    }

    row.style.position = "";
    row.style.left = "";
    row.style.top = "";
    row.style.width = "";
    row.style.height = "";
    row.style.margin = "";
    row.style.transform = "";
    row.style.transition = "";
    row.style.boxShadow = "";
    row.style.zIndex = "";
}


function cancelDrag() {

    const state =
        dragState;

    if (!state) {
        return;
    }


    cancelAnimationFrame(
        state.frame || 0
    );


    const row =
        state.row;

    const placeholder =
        state.placeholder;

    const list =
        $("itemList");


    if (
        placeholder &&
        placeholder.isConnected
    ) {
        placeholder.remove();
    }


    /*
        Restauramos la posición ORIGINAL,
        no la posición actual del placeholder.
    */
    const originalNextSibling =
        state.originalNextSibling;


    if (
        originalNextSibling &&
        originalNextSibling.parentNode === list
    ) {

        list.insertBefore(
            row,
            originalNextSibling
        );

    } else {

        list.appendChild(row);
    }


    clearDragInlineStyles(row);

    row.classList.remove(
        "dragging"
    );

    document.body.classList.remove(
        "drag-active"
    );


    dragState = null;
}


function finishDrag() {

    const state =
        dragState;

    if (!state) {
        return;
    }


    if (!state.started) {

        cancelDrag();

        return;
    }


    cancelAnimationFrame(
        state.frame || 0
    );


    const row =
        state.row;

    const placeholder =
        state.placeholder;

    const list =
        $("itemList");


    if (
        !placeholder ||
        !placeholder.isConnected
    ) {

        cancelDrag();

        return;
    }


    /*
        ESTE RECTÁNGULO ES LA POSICIÓN REAL
        DEL HUECO DONDE EL USUARIO HA SOLTADO.
    */
    const targetRect =
        placeholder.getBoundingClientRect();


    const currentRect =
        row.getBoundingClientRect();


    /*
        Primero colocamos físicamente el row
        exactamente donde estaba el placeholder.

        Esto hace que el orden DOM sea la fuente
        de verdad del drop.
    */
    placeholder.replaceWith(row);


    /*
        Conservamos temporalmente el elemento
        flotando para poder animarlo desde su
        posición actual hasta el hueco.
    */
    row.style.position =
        "fixed";

    row.style.left =
        currentRect.left + "px";

    row.style.top =
        currentRect.top + "px";

    row.style.width =
        targetRect.width + "px";

    row.style.height =
        targetRect.height + "px";

    row.style.margin =
        "0";

    row.style.transform =
        "scale(1.035)";

    row.style.transition =
        "left .2s cubic-bezier(.2,.8,.2,1), " +
        "top .2s cubic-bezier(.2,.8,.2,1), " +
        "transform .2s cubic-bezier(.2,.8,.2,1), " +
        "box-shadow .2s ease";

    row.style.boxShadow =
        "0 14px 30px rgba(0,0,0,.18)";


    requestAnimationFrame(() => {

        row.style.left =
            targetRect.left + "px";

        row.style.top =
            targetRect.top + "px";

        row.style.transform =
            "scale(1)";

        row.style.boxShadow =
            "0 4px 12px rgba(0,0,0,.08)";
    });


    /*
        MUY IMPORTANTE:
        El nuevo orden se obtiene directamente
        del DOM después de reemplazar el placeholder.
    */
    items =
        getItemRows()
            .map(
                currentRow =>
                    currentRow._item
            )
            .filter(Boolean);


    saveItems();

    generateHtml();


    suppressClickUntil =
        Date.now() + 350;


    setTimeout(() => {

        /*
            Puede que el elemento ya no exista
            si algo externo modificó la lista.
        */
        if (
            row &&
            row.isConnected
        ) {

            clearDragInlineStyles(row);

            row.classList.remove(
                "dragging"
            );
        }


        document.body.classList.remove(
            "drag-active"
        );


        dragState = null;


        /*
            Render final para sincronizar
            números, botones y estado.
        */
        renderItems();

        generateHtml();

    }, 220);
}


function startDrag(row, event) {

    if (
        event.target.closest("button") ||
        event.target.closest(".item-actions")
    ) {
        return;
    }


    if (dragState) {
        return;
    }


    const list =
        $("itemList");


    const rect =
        row.getBoundingClientRect();


    dragState = {

        row,

        pointerId:
            event.pointerId,

        startX:
            event.clientX,

        startY:
            event.clientY,

        currentX:
            event.clientX,

        currentY:
            event.clientY,

        originalNextSibling:
            row.nextElementSibling,

        placeholder:
            null,

        started:
            false,

        frame:
            0
    };


    row.setPointerCapture?.(
        event.pointerId
    );


    const pointerMove =
        moveEvent => {

            if (
                !dragState ||
                moveEvent.pointerId !==
                    dragState.pointerId
            ) {
                return;
            }


            dragState.currentX =
                moveEvent.clientX;

            dragState.currentY =
                moveEvent.clientY;


            const dx =
                moveEvent.clientX -
                dragState.startX;

            const dy =
                moveEvent.clientY -
                dragState.startY;


            const distance =
                Math.hypot(dx, dy);


            if (
                !dragState.started &&
                distance < 5
            ) {
                return;
            }


            if (!dragState.started) {

                dragState.started =
                    true;


                const placeholder =
                    createPlaceholder(row);


                dragState.placeholder =
                    placeholder;


                /*
                    El placeholder ocupa exactamente
                    el espacio original.
                */
                list.insertBefore(
                    placeholder,
                    row
                );


                row.classList.add(
                    "dragging"
                );


                row.style.position =
                    "fixed";

                row.style.left =
                    rect.left + "px";

                row.style.top =
                    rect.top + "px";

                row.style.width =
                    rect.width + "px";

                row.style.height =
                    rect.height + "px";

                row.style.margin =
                    "0";

                row.style.zIndex =
                    "1000";

                row.style.transform =
                    "scale(1.035)";

                row.style.transition =
                    "none";


                document.body.classList.add(
                    "drag-active"
                );
            }


            if (
                dragState.frame
            ) {
                return;
            }


            dragState.frame =
                requestAnimationFrame(
                    () => {

                        if (!dragState) {
                            return;
                        }


                        dragState.frame =
                            0;


                        const x =
                            dragState.currentX;

                        const y =
                            dragState.currentY;


                        row.style.left =
                            (
                                x -
                                rect.width / 2
                            ) + "px";


                        row.style.top =
                            (
                                y -
                                rect.height / 2
                            ) + "px";


                        updatePlaceholder(y);
                    }
                );


            moveEvent.preventDefault();
        };


    const pointerUp =
        upEvent => {

            if (
                !dragState ||
                upEvent.pointerId !==
                    dragState.pointerId
            ) {
                return;
            }


            document.removeEventListener(
                "pointermove",
                pointerMove
            );

            document.removeEventListener(
                "pointerup",
                pointerUp
            );

            document.removeEventListener(
                "pointercancel",
                pointerCancel
            );


            if (
                dragState.started
            ) {

                finishDrag();

            } else {

                cancelDrag();
            }
        };


    const pointerCancel =
        cancelEvent => {

            if (
                !dragState ||
                cancelEvent.pointerId !==
                    dragState.pointerId
            ) {
                return;
            }


            document.removeEventListener(
                "pointermove",
                pointerMove
            );

            document.removeEventListener(
                "pointerup",
                pointerUp
            );

            document.removeEventListener(
                "pointercancel",
                pointerCancel
            );


            cancelDrag();
        };


    document.addEventListener(
        "pointermove",
        pointerMove,
        {
            passive: false
        }
    );


    document.addEventListener(
        "pointerup",
        pointerUp
    );


    document.addEventListener(
        "pointercancel",
        pointerCancel
    );


    event.preventDefault();
}


function attachDragHandlers(row) {

    row.addEventListener(
        "pointerdown",
        event => {

            if (
                event.button !== undefined &&
                event.button !== 0
            ) {
                return;
            }

            startDrag(
                row,
                event
            );
        }
    );
}


window.addEventListener(
    "blur",
    () => {

        if (dragState) {
            cancelDrag();
        }
    }
);


/* =========================================================
   DIARY
========================================================= */

function formatDiaryText() {

    const textarea =
        $("diaryText");


    let text =
        normalizeText(
            textarea.value
        );


    text =
        text.replace(
            /\n[ \t]*---[ \t]*(?=\n|$)/g,
            "\n---"
        );


    textarea.value =
        text.trim();


    setStatus(
        "formStatus",
        "Diary formateado."
    );
}


$("formatDiaryButton")
    .addEventListener(
        "click",
        formatDiaryText
    );


function formatDiaryToHtml(text) {

    const normalized =
        normalizeText(text);


    const paragraphs =
        normalized
            .split(
                /^\s*---\s*$/m
            )
            .map(
                paragraph =>
                    paragraph.trim()
            )
            .filter(
                paragraph =>
                    paragraph.length > 0
            );


    return paragraphs
        .map(
            paragraph => {

                const escaped =
                    escapeHtml(
                        paragraph
                    )
                    .replace(
                        /\n/g,
                        "<br>"
                    );


                return (
                    `<p>${escaped}</p>`
                );
            }
        )
        .join(
            "\n<hr>\n"
        );
}


/* =========================================================
   GENERAR HTML
========================================================= */

function elementToHtml(item) {

    if (item.type === "polaroid") {

        const lines =
            normalizeText(
                item.caption
            )
            .split("\n")
            .filter(
                line =>
                    line.trim() !== ""
            );


        const listHtml =
            lines
                .map(
                    line =>
                        `<li>${escapeHtml(
                            capitalizeWords(line)
                        )}</li>`
                )
                .join("\n");


        return `<li>
<p><img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.alt)}"></p>
<ul>${listHtml}</ul>
</li>`;
    }


    if (item.type === "sticky") {

        const formattedText =
            normalizeText(
                item.text
            )
            .split("\n")
            .map(
                line =>
                    capitalizeWords(line)
            )
            .join("\n");


        return `<li>
<p>${escapeHtml(formattedText).replace(/\n/g, "<br>")}</p>
</li>`;
    }


    if (item.type === "sticky-fecha") {

        const formattedText =
            normalizeText(
                item.text
            )
            .split("\n")
            .map(
                line =>
                    capitalizeWords(line)
            )
            .join("\n");


        return `<li>
<p>${escapeHtml(formattedText).replace(/\n/g, "<br>")}</p>
<ul><li>${escapeHtml(item.fecha)}</li></ul>
</li>`;
    }


    if (item.type === "sticky-png") {

        return `<li>
<img src="${escapeHtml(item.image)}" class="sticky-drawing" alt="${escapeHtml(item.alt)}">
<p></p>
</li>`;
    }


    if (item.type === "ticket") {

        return `<li class="ticket-frame">
<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.alt)}">
</li>`;
    }


    if (item.type === "png-frame") {

        return `<li class="png-frame" style="--png-scale: ${escapeHtml(item.scale)};">
<img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.alt)}">
</li>`;
    }


    if (item.type === "diary") {

        const diaryContent =
            formatDiaryToHtml(
                item.text
            );


        return `<li>
<img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="Diario">
${diaryContent}
</li>`;
    }


    if (item.type === "film-strip") {

        const images =
            Array.isArray(item.images)
                ? item.images
                : [];


        const frames =
            images
                .slice(0, 3)
                .map(
                    image => {

                        if (
                            !image ||
                            !image.image
                        ) {
                            return "";
                        }


                        return `<div class="film-frame">
<img src="${escapeHtml(image.image)}" alt="${escapeHtml(image.alt || "")}">
</div>`;
                    }
                )
                .filter(Boolean)
                .join("\n");


        return `<li class="film-strip">
${frames}
</li>`;
    }


    return "";
}


function generateHtml() {

    const content =
        items
            .map(
                item =>
                    elementToHtml(item)
            )
            .filter(Boolean)
            .join("\n");


    const html =
        `<section class="tiny-photos">
<ul>
${content}
</ul>
</section>`;


    $("output").value =
        html;


    return html;
}


/* =========================================================
   LOCAL STORAGE
========================================================= */

function saveItems() {

    try {

        localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify(items)
        );

    } catch (error) {

        console.error(
            "No se pudo guardar:",
            error
        );
    }
}


function loadItems() {

    try {

        const saved =
            localStorage.getItem(
                STORAGE_KEY
            );


        if (!saved) {
            items = [];
            return;
        }


        const parsed =
            JSON.parse(saved);


        if (
            Array.isArray(parsed)
        ) {

            items =
                parsed;
        } else {

            items = [];
        }

    } catch (error) {

        console.error(
            "No se pudo cargar:",
            error
        );

        items = [];
    }
}


