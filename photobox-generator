<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PhotoBox Generator</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 24px;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f3f3;
            color: #222;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
        }

        h1 {
            margin: 0 0 8px;
            font-size: 28px;
        }

        h2 {
            margin-top: 0;
            font-size: 20px;
        }

        .subtitle {
            color: #666;
            margin-bottom: 24px;
        }

        .panel {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 18px;
            margin-bottom: 18px;
        }

        .field {
            margin-bottom: 14px;
        }

        label {
            display: block;
            font-weight: 700;
            margin-bottom: 6px;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 10px 11px;
            border: 1px solid #ccc;
            border-radius: 6px;
            background: #fff;
            color: #222;
            font-family: inherit;
            font-size: 14px;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #888;
            box-shadow: 0 0 0 2px rgba(0, 0, 0, .05);
        }

        textarea {
            min-height: 130px;
            resize: vertical;
        }

        .help {
            margin-top: 5px;
            color: #777;
            font-size: 12px;
            line-height: 1.45;
        }

        button {
            border: 1px solid #d2d2d2;
            border-radius: 6px;
            padding: 9px 13px;
            cursor: pointer;
            font-weight: 600;
            background: #f7f7f7;
            color: #333;
            margin-right: 6px;
            margin-bottom: 6px;
            box-shadow: none;
            transition:
                background .15s ease,
                border-color .15s ease,
                color .15s ease,
                transform .1s ease;
        }

        button:hover {
            background: #ececec;
            border-color: #bdbdbd;
        }

        button:active {
            transform: translateY(1px);
        }

        button.secondary {
            background: #f7f7f7;
            color: #555;
            border-color: #d2d2d2;
        }

        button.success {
            background: #eeeeee;
            color: #222;
            border-color: #c8c8c8;
        }

        button.danger {
            background: #f7f7f7;
            color: #555;
            border-color: #d2d2d2;
        }

        button.format {
            background: #f7f7f7;
            color: #444;
            border-color: #d2d2d2;
        }

        .type-selector {
            display: block;
            margin-bottom: 18px;
        }

        .type-selector label {
            margin-bottom: 7px;
        }

        .dynamic-fields {
            display: block;
        }

        .hidden {
            display: none !important;
        }

        .actions {
            margin-top: 12px;
        }

        .items-list {
            min-height: 20px;
        }

        .empty {
            color: #777;
            padding: 18px;
            text-align: center;
            border: 1px dashed #ccc;
            border-radius: 8px;
            background: #fafafa;
        }

        .item {
            position: relative;
            background: #fafafa;
            border: 1px solid #ddd;
            border-radius: 9px;
            padding: 12px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: grab;
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            transform: scale(1);
            transition:
                opacity .15s ease,
                transform .18s ease,
                border-color .15s ease,
                background .15s ease,
                box-shadow .18s ease;
        }

        .item:hover {
            background: #fdfdfd;
            border-color: #cfcfcf;
        }

        .item.dragging {
            opacity: .95;
            background: #fff;
            border-color: #999;
            transform: scale(1.035) translateY(-2px);
            box-shadow:
                0 14px 30px rgba(0,0,0,.18),
                0 3px 8px rgba(0,0,0,.10);
            z-index: 1000;
        }

        .item.dragging::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 9px;
            pointer-events: none;
            box-shadow: inset 0 0 0 2px rgba(0,0,0,.08);
        }

        .item-number {
            flex: 0 0 auto;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e9e9e9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            color: #555;
        }

        .item-info {
            flex: 1;
            min-width: 0;
        }

        .item-type {
            font-weight: 700;
            margin-bottom: 3px;
        }

        .item-description {
            color: #777;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .item-actions {
            flex: 0 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .item-actions button {
            margin-bottom: 0;
            padding: 6px 8px;
            font-size: 12px;
        }

        .drag-placeholder {
            box-sizing: border-box;
            border: 2px dashed #c7c7c7;
            border-radius: 9px;
            background: #f5f5f5;
            margin-bottom: 8px;
            position: relative;
            opacity: .95;
            transition:
                height .15s ease,
                opacity .15s ease;
        }

        .drag-placeholder::before {
            content: "";
            position: absolute;
            left: 14px;
            right: 14px;
            top: 50%;
            height: 2px;
            transform: translateY(-50%);
            background: #d0d0d0;
            border-radius: 999px;
        }

        body.drag-active {
            user-select: none;
            -webkit-user-select: none;
            cursor: grabbing;
        }

        .output {
            width: 100%;
            min-height: 260px;
            font-family: Consolas, Monaco, monospace;
            font-size: 13px;
            line-height: 1.5;
            white-space: pre;
        }

        .import-area {
            min-height: 220px;
            font-family: Consolas, Monaco, monospace;
            font-size: 13px;
        }

        .status {
            margin-top: 8px;
            min-height: 20px;
            color: #666;
            font-size: 13px;
        }

        .status.success-text {
            color: #333;
        }

        .status.error-text {
            color: #9b0000;
        }

        .two-columns {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        @media (max-width: 760px) {
            body {
                padding: 12px;
            }

            .two-columns {
                grid-template-columns: 1fr;
            }

            .item {
                align-items: flex-start;
            }

            .item-actions {
                flex-direction: column;
            }

            .item-actions button {
                width: 100%;
                margin-bottom: 4px;
            }
        }
    </style>
</head>

<body>
<div class="container">

    <h1>PhotoBox Generator</h1>

    <div class="subtitle">
        Crea, ordena y genera tu bloque
        <code>&lt;section class="tiny-photos"&gt;</code>.
    </div>

    <!-- FORMULARIO -->
    <div class="panel">

        <h2>Añadir / editar elemento</h2>

        <!-- IMPORTANTE:
             Este selector permanece SIEMPRE visible.
             Solo cambian los campos de abajo. -->
        <div class="type-selector">
            <label for="elementType">Tipo de elemento</label>

            <select id="elementType">
                <option value="polaroid">Polaroid</option>
                <option value="sticky">Sticky Note</option>
                <option value="sticky-fecha">Sticky Note + Fecha</option>
                <option value="sticky-png">Sticky PNG</option>
                <option value="ticket">Ticket</option>
                <option value="png-frame">PNG Frame</option>
                <option value="diary">Diary Notes</option>
                <option value="film-strip">Film Strip</option>
            </select>
        </div>

        <!-- CAMPOS DINÁMICOS -->
        <div id="dynamicFields" class="dynamic-fields">

            <!-- POLAROID -->
            <div id="fields-polaroid">

                <div class="field">
                    <label for="polaroidImage">
                        URL de la imagen
                    </label>

                    <input
                        id="polaroidImage"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="polaroidAlt">
                        ALT de la imagen
                    </label>

                    <input
                        id="polaroidAlt"
                        type="text"
                        placeholder="Descripción de la imagen"
                    >
                </div>

                <div class="field">
                    <label for="polaroidCaption">
                        Caption
                    </label>

                    <textarea
                        id="polaroidCaption"
                        placeholder="Una línea por caption"
                    ></textarea>

                    <div class="help">
                        Cada línea se convierte en un
                        <code>&lt;li&gt;</code>.
                        En el HTML generado, la primera letra de cada
                        palabra se pondrá en mayúscula.
                    </div>
                </div>

            </div>

            <!-- STICKY -->
            <div id="fields-sticky" class="hidden">

                <div class="field">
                    <label for="stickyText">
                        Texto del Sticky Note
                    </label>

                    <textarea
                        id="stickyText"
                        placeholder="Escribe el texto..."
                    ></textarea>

                    <div class="help">
                        En el HTML generado, la primera letra de cada
                        palabra se pondrá en mayúscula.
                    </div>
                </div>

            </div>

            <!-- STICKY FECHA -->
            <div id="fields-sticky-fecha" class="hidden">

                <div class="field">
                    <label for="stickyFechaText">
                        Texto del Sticky Note
                    </label>

                    <textarea
                        id="stickyFechaText"
                        placeholder="Escribe el texto..."
                    ></textarea>

                    <div class="help">
                        En el HTML generado, la primera letra de cada
                        palabra se pondrá en mayúscula.
                    </div>
                </div>

                <div class="field">
                    <label for="stickyFechaFecha">
                        Fecha
                    </label>

                    <input
                        id="stickyFechaFecha"
                        type="text"
                        placeholder="12.05.2026"
                    >
                </div>

            </div>

            <!-- STICKY PNG -->
            <div id="fields-sticky-png" class="hidden">

                <div class="field">
                    <label for="stickyPngImage">
                        URL del PNG
                    </label>

                    <input
                        id="stickyPngImage"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="stickyPngAlt">
                        ALT del PNG
                    </label>

                    <input
                        id="stickyPngAlt"
                        type="text"
                        placeholder="Descripción del dibujo"
                    >
                </div>

            </div>

            <!-- TICKET -->
            <div id="fields-ticket" class="hidden">

                <div class="field">
                    <label for="ticketImage">
                        URL de la imagen
                    </label>

                    <input
                        id="ticketImage"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="ticketAlt">
                        ALT de la imagen
                    </label>

                    <input
                        id="ticketAlt"
                        type="text"
                        placeholder="Descripción"
                    >
                </div>

            </div>

            <!-- PNG FRAME -->
            <div id="fields-png-frame" class="hidden">

                <div class="two-columns">

                    <div class="field">
                        <label for="pngFrameImage">
                            URL del PNG
                        </label>

                        <input
                            id="pngFrameImage"
                            type="text"
                            placeholder="https://..."
                        >
                    </div>

                    <div class="field">
                        <label for="pngFrameScale">
                            Escala
                        </label>

                        <input
                            id="pngFrameScale"
                            type="number"
                            step="0.1"
                            min="0.1"
                            value="1.4"
                        >
                    </div>

                </div>

                <div class="field">
                    <label for="pngFrameAlt">
                        ALT del PNG
                    </label>

                    <input
                        id="pngFrameAlt"
                        type="text"
                        placeholder="Descripción"
                    >
                </div>

            </div>

            <!-- DIARY -->
            <div id="fields-diary" class="hidden">

                <div class="field">
                    <label for="diaryText">
                        Contenido del Diary Notes
                    </label>

                    <textarea
                        id="diaryText"
                        placeholder="Primer párrafo

---

Segundo párrafo"
                    ></textarea>

                    <div class="help">
                        Escribe <code>---</code> en una línea independiente
                        para separar párrafos.
                        Al generar el HTML se convertirán en
                        <code>&lt;p&gt;...&lt;/p&gt;&lt;hr&gt;&lt;p&gt;...&lt;/p&gt;</code>.
                    </div>
                </div>

                <button
                    type="button"
                    class="format"
                    id="formatDiaryButton"
                >
                    ✨ Formatear Diary
                </button>

            </div>

            <!-- FILM STRIP -->
            <div id="fields-film-strip" class="hidden">

                <div class="field">
                    <label for="filmStripName">
                        Nombre / comentario del Film Strip
                    </label>

                    <input
                        id="filmStripName"
                        type="text"
                        placeholder="Ej: Viaje por Patagonia"
                    >

                    <div class="help">
                        Este nombre sirve para identificar el Film Strip
                        en la lista de elementos activos.
                        No se añadirá al HTML generado.
                    </div>
                </div>

                <div class="field">
                    <label for="filmStripImage1">
                        Imagen 1
                    </label>

                    <input
                        id="filmStripImage1"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="filmStripAlt1">
                        ALT imagen 1
                    </label>

                    <input
                        id="filmStripAlt1"
                        type="text"
                        placeholder="Descripción"
                    >
                </div>

                <div class="field">
                    <label for="filmStripImage2">
                        Imagen 2
                    </label>

                    <input
                        id="filmStripImage2"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="filmStripAlt2">
                        ALT imagen 2
                    </label>

                    <input
                        id="filmStripAlt2"
                        type="text"
                        placeholder="Descripción"
                    >
                </div>

                <div class="field">
                    <label for="filmStripImage3">
                        Imagen 3
                    </label>

                    <input
                        id="filmStripImage3"
                        type="text"
                        placeholder="https://..."
                    >
                </div>

                <div class="field">
                    <label for="filmStripAlt3">
                        ALT imagen 3
                    </label>

                    <input
                        id="filmStripAlt3"
                        type="text"
                        placeholder="Descripción"
                    >
                </div>

            </div>

        </div>

        <div class="actions">
            <button
                type="button"
                class="success"
                id="addButton"
            >
                + Añadir elemento
            </button>

            <button
                type="button"
                class="secondary"
                id="cancelEditButton"
            >
                Cancelar edición
            </button>
        </div>

        <div id="formStatus" class="status"></div>

    </div>


    <!-- ELEMENTOS ACTIVOS -->
    <div class="panel">

        <h2>Elementos activos</h2>

        <div class="help" style="margin-bottom:12px;">
            Arrastra los elementos para cambiar su orden.
        </div>

        <div id="itemList" class="items-list"></div>

    </div>


    <!-- HTML GENERADO -->
    <div class="panel">

        <h2>HTML generado</h2>

        <textarea
            id="output"
            class="output"
            spellcheck="false"
            readonly
        ></textarea>

        <div class="actions">

            <button
                type="button"
                id="copyButton"
                class="success"
            >
                Copiar HTML
            </button>

            <button
                type="button"
                id="downloadButton"
                class="secondary"
            >
                Descargar HTML
            </button>

            <button
                type="button"
                id="resetButton"
                class="danger"
            >
                Vaciar todo
            </button>

        </div>

        <div id="outputStatus" class="status"></div>

    </div>


    <!-- IMPORTAR -->
    <div class="panel">

        <h2>Importar HTML existente</h2>

        <div class="help" style="margin-bottom:10px;">
            Puedes pegar un documento HTML completo, un
            <code>&lt;section class="tiny-photos"&gt;</code>
            o directamente un
            <code>&lt;ul&gt;</code>.
        </div>

        <textarea
            id="importArea"
            class="import-area"
            spellcheck="false"
            placeholder="Pega aquí tu HTML..."
        ></textarea>

        <div class="actions">

            <button
                type="button"
                id="importButton"
                class="success"
            >
                Importar HTML
            </button>

        </div>

        <div id="importStatus" class="status"></div>

    </div>

</div>


<script>
"use strict";


/* =========================================================
   CONFIGURACIÓN
========================================================= */

const STORAGE_KEY =
    "photobox-generator-items-v4";


let items = [];

let editingIndex = -1;

let suppressClickUntil = 0;

let dragState = null;


/* =========================================================
   UTILIDADES
========================================================= */

function $(id) {
    return document.getElementById(id);
}


function normalizeText(value) {
    return String(value ?? "")
        .replace(/\r\n/g, "\n")
        .replace(/\r/g, "\n");
}


function escapeHtml(value) {
    return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/*
    Convierte:

    hola mundo
    MI CASA
    buenas TARDES

    en:

    Hola Mundo
    Mi Casa
    Buenas Tardes
*/
function capitalizeWords(value) {
    return String(value ?? "")
        .toLocaleLowerCase("es-ES")
        .replace(
            /(^|[\s\u00A0]+)([^\s\u00A0])/g,
            function(
                match,
                separator,
                firstLetter
            ) {
                return (
                    separator +
                    firstLetter.toLocaleUpperCase("es-ES")
                );
            }
        );
}


function setStatus(elementId, message, isError = false) {
    const element = $(elementId);

    element.textContent = message;

    element.classList.toggle(
        "error-text",
        isError
    );

    element.classList.toggle(
        "success-text",
        !isError && message !== ""
    );
}


/* =========================================================
   TIPO DE ELEMENTO
========================================================= */

const allFieldGroups = [
    "polaroid",
    "sticky",
    "sticky-fecha",
    "sticky-png",
    "ticket",
    "png-frame",
    "diary",
    "film-strip"
];


function updateTypeFields() {

    const selectedType =
        $("elementType").value;

    /*
        IMPORTANTE:
        El selector NO se toca ni se oculta.
        Solo ocultamos/mostramos los campos inferiores.
    */

    allFieldGroups.forEach(type => {

        const group =
            $("fields-" + type);

        if (!group) {
            return;
        }

        group.classList.toggle(
            "hidden",
            type !== selectedType
        );
    });
}


/* =========================================================
   DATOS DEL FORMULARIO
========================================================= */

function getFormData() {

    const type =
        $("elementType").value;


    if (type === "polaroid") {

        return {
            type,
            image: $("polaroidImage").value.trim(),
            alt: $("polaroidAlt").value.trim(),
            caption: normalizeText(
                $("polaroidCaption").value
            )
        };
    }


    if (type === "sticky") {

        return {
            type,
            text: normalizeText(
                $("stickyText").value
            )
        };
    }


    if (type === "sticky-fecha") {

        return {
            type,
            text: normalizeText(
                $("stickyFechaText").value
            ),
            fecha:
                $("stickyFechaFecha").value.trim()
        };
    }


    if (type === "sticky-png") {

        return {
            type,
            image:
                $("stickyPngImage").value.trim(),
            alt:
                $("stickyPngAlt").value.trim()
        };
    }


    if (type === "ticket") {

        return {
            type,
            image:
                $("ticketImage").value.trim(),
            alt:
                $("ticketAlt").value.trim()
        };
    }


    if (type === "png-frame") {

        let scale =
            parseFloat(
                $("pngFrameScale").value
            );

        if (!Number.isFinite(scale)) {
            scale = 1.4;
        }

        return {
            type,
            image:
                $("pngFrameImage").value.trim(),
            alt:
                $("pngFrameAlt").value.trim(),
            scale
        };
    }


    if (type === "diary") {

        return {
            type,
            text: normalizeText(
                $("diaryText").value
            )
        };
    }


    if (type === "film-strip") {

        return {
            type,

            name:
                $("filmStripName").value.trim(),

            images: [
                {
                    image:
                        $("filmStripImage1").value.trim(),
                    alt:
                        $("filmStripAlt1").value.trim()
                },
                {
                    image:
                        $("filmStripImage2").value.trim(),
                    alt:
                        $("filmStripAlt2").value.trim()
                },
                {
                    image:
                        $("filmStripImage3").value.trim(),
                    alt:
                        $("filmStripAlt3").value.trim()
                }
            ]
        };
    }


    return {
        type
    };
}


/* =========================================================
   LIMPIAR FORMULARIO
========================================================= */

function clearForm() {

    editingIndex = -1;

    $("elementType").value =
        "polaroid";


    $("polaroidImage").value = "";
    $("polaroidAlt").value = "";
    $("polaroidCaption").value = "";


    $("stickyText").value = "";


    $("stickyFechaText").value = "";
    $("stickyFechaFecha").value = "";


    $("stickyPngImage").value = "";
    $("stickyPngAlt").value = "";


    $("ticketImage").value = "";
    $("ticketAlt").value = "";


    $("pngFrameImage").value = "";
    $("pngFrameAlt").value = "";
    $("pngFrameScale").value = "1.4";


    $("diaryText").value = "";


    $("filmStripName").value = "";

    $("filmStripImage1").value = "";
    $("filmStripAlt1").value = "";

    $("filmStripImage2").value = "";
    $("filmStripAlt2").value = "";

    $("filmStripImage3").value = "";
    $("filmStripAlt3").value = "";


    $("addButton").textContent =
        "+ Añadir elemento";


    updateTypeFields();

    setStatus(
        "formStatus",
        ""
    );
}


/* =========================================================
   EDITAR ELEMENTO
========================================================= */

function editItem(index) {

    const item =
        items[index];

    if (!item) {
        return;
    }


    editingIndex = index;

    $("elementType").value =
        item.type;


    updateTypeFields();


    if (item.type === "polaroid") {

        $("polaroidImage").value =
            item.image || "";

        $("polaroidAlt").value =
            item.alt || "";

        $("polaroidCaption").value =
            item.caption || "";
    }


    if (item.type === "sticky") {

        $("stickyText").value =
            item.text || "";
    }


    if (item.type === "sticky-fecha") {

        $("stickyFechaText").value =
            item.text || "";

        $("stickyFechaFecha").value =
            item.fecha || "";
    }


