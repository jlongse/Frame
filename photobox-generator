/* =========================================================
   IMPORTAR HTML
========================================================= */

function findTinyPhotosRoot(documentObject) {

    const section =
        documentObject.querySelector(
            "section.tiny-photos"
        );


    if (section) {
        return section;
    }


    const ul =
        documentObject.querySelector(
            "ul"
        );


    return ul || null;
}


function importPolaroid(li) {

    const img =
        li.querySelector(
            ":scope > p img"
        );


    if (!img) {
        return null;
    }


    const list =
        li.querySelector(
            ":scope > ul"
        );


    const caption =
        list
            ? [
                ...list.querySelectorAll(
                    ":scope > li"
                )
            ]
                .map(
                    element =>
                        element.textContent.trim()
                )
                .join("\n")
            : "";


    return {
        type: "polaroid",

        image:
            img.getAttribute("src") || "",

        alt:
            img.getAttribute("alt") || "",

        caption
    };
}


function importFilmStrip(li) {

    const frames =
        [
            ...li.querySelectorAll(
                ":scope > .film-frame"
            )
        ];


    if (!frames.length) {
        return null;
    }


    return {
        type: "film-strip",

        name: "",

        images:
            frames
                .slice(0, 3)
                .map(
                    frame => {

                        const img =
                            frame.querySelector(
                                "img"
                            );


                        return {
                            image:
                                img?.getAttribute(
                                    "src"
                                ) || "",

                            alt:
                                img?.getAttribute(
                                    "alt"
                                ) || ""
                        };
                    }
                )
    };
}


function importDiary(li) {

    /*
        Primero intentamos detectar el formato nuevo:
            <p>...</p>
            <hr>
            <p>...</p>
    */

    const paragraphs =
        [
            ...li.querySelectorAll(
                ":scope > p"
            )
        ];


    if (paragraphs.length > 0) {

        const parts = [];


        paragraphs.forEach(
            (paragraph, index) => {

                if (index > 0) {
                    parts.push("---");
                }


                parts.push(
                    paragraph.innerText.trim()
                );
            }
        );


        return {
            type: "diary",
            text:
                parts.join("\n")
        };
    }


    /*
        Compatibilidad con HTML anterior
        que ya tuviera <hr>.
    */

    const clone =
        li.cloneNode(true);


    const hrs =
        [
            ...clone.querySelectorAll(
                "hr"
            )
        ];


    hrs.forEach(
        hr =>
            hr.replaceWith(
                document.createTextNode(
                    "\n---\n"
                )
            )
    );


    return {
        type: "diary",
        text:
            clone.innerText.trim()
    };
}


function importSticky(li) {

    const p =
        li.querySelector(
            ":scope > p"
        );


    if (!p) {
        return null;
    }


    return {
        type: "sticky",

        text:
            p.innerText || ""
    };
}


function importStickyFecha(li) {

    const p =
        li.querySelector(
            ":scope > p"
        );


    const ul =
        li.querySelector(
            ":scope > ul"
        );


    if (!p) {
        return null;
    }


    const fecha =
        ul?.querySelector(
            ":scope > li"
        )?.textContent.trim() || "";


    return {
        type: "sticky-fecha",

        text:
            p.innerText || "",

        fecha
    };
}


function importStickyPng(li) {

    const img =
        li.querySelector(
            ":scope > img.sticky-drawing"
        );


    if (!img) {
        return null;
    }


    return {
        type: "sticky-png",

        image:
            img.getAttribute("src") || "",

        alt:
            img.getAttribute("alt") || ""
    };
}


function importTicket(li) {

    if (
        !li.classList.contains(
            "ticket-frame"
        )
    ) {
        return null;
    }


    const img =
        li.querySelector(
            ":scope > img"
        );


    if (!img) {
        return null;
    }


    return {
        type: "ticket",

        image:
            img.getAttribute("src") || "",

        alt:
            img.getAttribute("alt") || ""
    };
}


function importPngFrame(li) {

    if (
        !li.classList.contains(
            "png-frame"
        )
    ) {
        return null;
    }


    const img =
        li.querySelector(
            ":scope > img"
        );


    if (!img) {
        return null;
    }


    const style =
        li.getAttribute(
            "style"
        ) || "";


    const match =
        style.match(
            /--png-scale\s*:\s*([^;]+)/
        );


    let scale =
        match
            ? parseFloat(match[1])
            : 1.4;


    if (!Number.isFinite(scale)) {
        scale = 1.4;
    }


    return {
        type: "png-frame",

        image:
            img.getAttribute("src") || "",

        alt:
            img.getAttribute("alt") || "",

        scale
    };
}


function importLi(li) {

    /*
        El orden es importante.
    */

    if (
        li.classList.contains(
            "film-strip"
        )
    ) {
        return importFilmStrip(li);
    }


    if (
        li.classList.contains(
            "ticket-frame"
        )
    ) {
        return importTicket(li);
    }


    if (
        li.classList.contains(
            "png-frame"
        )
    ) {
        return importPngFrame(li);
    }


    if (
        li.querySelector(
            ":scope > img.sticky-drawing"
        )
    ) {
        return importStickyPng(li);
    }


    if (
        li.querySelector(
            ":scope > hr"
        )
    ) {
        return importDiary(li);
    }


    if (
        li.querySelector(
            ":scope > p"
        ) &&
        li.querySelector(
            ":scope > ul"
        )
    ) {
        return importStickyFecha(li);
    }


    if (
        li.querySelector(
            ":scope > p img"
        )
    ) {
        return importPolaroid(li);
    }


    if (
        li.querySelector(
            ":scope > p"
        )
    ) {
        return importSticky(li);
    }


    /*
        Compatibilidad adicional:
        si parece un Diary antiguo.
    */
    if (
        li.querySelector(
            "hr"
        )
    ) {
        return importDiary(li);
    }


    return null;
}


function importHtml() {

    const source =
        $("importArea").value.trim();


    if (!source) {

        setStatus(
            "importStatus",
            "Pega primero el HTML que quieres importar.",
            true
        );

        return;
    }


    try {

        const parser =
            new DOMParser();


        const doc =
            parser.parseFromString(
                source,
                "text/html"
            );


        const root =
            findTinyPhotosRoot(
                doc
            );


        if (!root) {

            setStatus(
                "importStatus",
                "No se encontró un section tiny-photos ni un ul.",
                true
            );

            return;
        }


        const imported =
            [
                ...root.querySelectorAll(
                    ":scope > ul > li"
                )
            ]
                .map(
                    li =>
                        importLi(li)
                )
                .filter(Boolean);


        /*
            Si el root ya es el UL.
        */
        if (
            root.tagName.toLowerCase() ===
            "ul"
        ) {

            imported.length = 0;


            [
                ...root.querySelectorAll(
                    ":scope > li"
                )
            ]
                .map(
                    li =>
                        importLi(li)
                )
                .filter(Boolean)
                .forEach(
                    item =>
                        imported.push(item)
                );
        }


        if (!imported.length) {

            setStatus(
                "importStatus",
                "No se encontraron elementos compatibles.",
                true
            );

            return;
        }


        items =
            imported;


        saveItems();

        clearForm();

        renderItems();

        generateHtml();


        setStatus(
            "importStatus",
            imported.length +
            " elemento(s) importado(s) correctamente."
        );


        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });

    } catch (error) {

        console.error(
            error
        );


        setStatus(
            "importStatus",
            "No se pudo importar el HTML.",
            true
        );
    }
}


$("importButton")
    .addEventListener(
        "click",
        importHtml
    );


